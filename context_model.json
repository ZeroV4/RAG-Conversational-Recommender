{
  "title": "Movie Context",
  "description": "Context with regards to movie recommendations.",
  "fields": [
    {
      "id": "available_minutes",
      "label": "How many minutes are available?",
      "type": "number",
      "default": 120,
      "include_in_retrieval": false,
      "item_fields": [
        "duration_minutes"
      ],
      "weight": 1,
      "matching": "prefer_smaller",
      "constraint": {
        "operator": "maximum",
        "item_field": "duration_minutes"
      }
    },
    {
      "id": "latest_release_year",
      "label": "What is the latest the movie should have been released?",
      "type": "number",
      "default": 2025,
      "include_in_retrieval": false,
      "item_fields": [
        "release_year"
      ],
      "weight": 1,
      "matching": "prefer_smaller",
      "constraint": {
        "operator": "maximum",
        "item_field": "release_year"
      }
    },
    {
      "id": "rating",
      "label": "Preferred rating",
      "type": "text",
      "default": "",
      "include_in_retrieval": true,
      "item_fields": [
        "rating"
      ],
      "weight": 0.5,
      "matching": "token_overlap"
    },
    {
      "id": "format",
      "label": "Preferred format",
      "type": "text",
      "default": "",
      "include_in_retrieval": true,
      "item_fields": [
        "format"
      ],
      "weight": 0.5,
      "matching": "token_overlap"
    }
  ]
}
