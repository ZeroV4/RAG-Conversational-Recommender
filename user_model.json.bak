{
  "title": "User model",
  "description": "Relatively stable characteristics and preferences used for personalisation.",
  "fields": [
    {
      "id": "available_minutes",
      "label": "How many minutes are available?",
      "type": "number",
      "default": 120,
      "include_in_retrieval": false,
      "item_fields": [
        "duration_minutes"
      ],
      "weight": 1,
      "matching": "prefer_smaller",
      "constraint": {
        "operator": "maximum",
        "item_field": "duration_minutes"
      }
    },
    {
      "id": "release_year",
      "label": "What is the latest the movie should have been released?",
      "type": "number",
      "default": 2015,
      "include_in_retrieval": false,
      "item_fields": [
        "release_year"
      ],
      "weight": 1,
      "matching": "prefer_smaller",
      "constraint": {
        "operator": "maximum",
        "item_field": "release_year"
      }
    },
    {
      "id": "preferred_genre",
      "label": "Preferred genre",
      "type": "tags",
      "default": [
        "adventure"
      ],
      "include_in_retrieval": true,
      "item_fields": [
        "genres"
      ],
      "weight": 2
    },
    {
      "id": "themes",
      "label": "Favourite themes",
      "type": "text",
      "default": "family",
      "include_in_retrieval": true,
      "item_fields": [
        "topics",
        "description"
      ],
      "weight": 1.5,
      "matching": "token_overlap"
    }
  ]
}
